{
  "name": "Inshare",
  "description": "share your link for everyone to admire",
  "version": "1.0.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "permissions": ["storage", "tabs", "scripting", "cookies"],
  "host_permissions": ["<all_urls>"],

  "icons": {
    "16": "/images/bokmarke16.png",
    "32": "/images/bokmarke32.png",
    "128": "/images/bokmarke128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["/images/chesta256.png"],
      "matches": ["<all_urls>"]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "inshare@example.com",
      "strict_min_version": "121.0"
    }
  }
}
